-Seed "Test2025"
-read   +nodefile "%BASE_PATH%/input/stark_prime/nodes.tsv"
        +edgefile "%BASE_PATH%/input/stark_prime/edges.tsv"
        +arg name "STaRK-Prime Biomedical Dataset"
        +arg AUTHOR "Stanford/Amazon"
        +arg PROCESSED_BY "Lorenzo Bellomo"
        +arg LICENSE "CC-BY-4.0 - Attribution"

-save   "%BASE_PATH%/output/stark_prime_model.m1"
-generate   "%BASE_PATH%/output/stark_prime_nodes_x1.tsv" "%BASE_PATH%/output/stark_prime_edges_x1.tsv" 1
-Scale 10
-generate   "%BASE_PATH%/output/stark_prime_nodes_x10.tsv" "%BASE_PATH%/output/stark_prime_edges_x10.tsv" 1
-Scale 0.025
-generate   "%BASE_PATH%/output/stark_prime_nodes_x025.tsv" "%BASE_PATH%/output/stark_prime_edges_x025.tsv" 1



-Seed "Test2025"
-read   +nodefile "%BASE_PATH%/input/dblp_citation/nodes.tsv"
        +edgefile "%BASE_PATH%/input/dblp_citation/edges.tsv"
        +edgeindex 0 2
        +edgetypeindex 1
        +arg name "dblp Citation Network"
        +arg AUTHOR "Uni Trier / Schloss Dagstuhl"
        +arg PROCESSED_BY "Lorenzo Bellomo"
        +arg LICENSE "Creative Commons 0 - Public Domain"

-save   "%BASE_PATH%/output/dblp_citation_model.m1"
-generate   "%BASE_PATH%/output/dblp_citation_nodes_x1.tsv" "%BASE_PATH%/output/dblp_citation_edges_x1.tsv" 1
-Scale 10
-generate   "%BASE_PATH%/output/dblp_citation_nodes_x10.tsv" "%BASE_PATH%/output/dblp_citation_edges_x10.tsv" 1
-Scale 0.025
-generate   "%BASE_PATH%/output/dblp_citation_nodes_x025.tsv" "%BASE_PATH%/output/dblp_citation_edges_x025.tsv" 1



-Seed "Test2025"
-read   +nodefile "%BASE_PATH%/input/patents/nodes.tsv"
        +edgefile "%BASE_PATH%/input/patents/edges.tsv"
        +edgeindex 0 2
        +edgetypeindex 1
        +arg name "US-Patent Relationships (1976-2006)"
        +arg AUTHOR "Patent Data Project (PDP)"
        +arg PROCESSED_BY "Lorenzo Bellomo"
        +arg LICENSE "Unknown"

-save   "%BASE_PATH%/output/patents_model.m1"
-generate   "%BASE_PATH%/output/patents_nodes_x1.tsv" "%BASE_PATH%/output/patents_edges_x1.tsv" 1
-Scale 10
-generate   "%BASE_PATH%/output/patents_nodes_x10.tsv" "%BASE_PATH%/output/patents_edges_x10.tsv" 1
-Scale 0.025
-generate   "%BASE_PATH%/output/patents_nodes_x025.tsv" "%BASE_PATH%/output/patents_edges_x025.tsv" 1