-Seed "Test2025"

-execute "../scripts/scaling_test_template.s1"
    "%PATH%"  	"%BASE_PATH%"
    "%FNAME%"	"geometric_10k"
    "%NAME%"    "Artificial dataset (geometric distribution, ~10k nodes, p=0.2, offset=0)"
    "%AUTHOR%"	"Benjamin E. Raabe"
    "%LICENSE%"	"Creative Commons 0 - Public Domain"

-execute "../scripts/scaling_test_template.s1"
    "%PATH%"  	"%BASE_PATH%"
    "%FNAME%"	"offset_geometric_10k"
    "%NAME%"    "Artificial dataset (exponential distribution, ~10k nodes, lambda=5, offset=10)"
    "%AUTHOR%"	"Benjamin E. Raabe"
    "%LICENSE%"	"Creative Commons 0 - Public Domain"

-execute "../scripts/scaling_test_template.s1"
    "%PATH%"  	"%BASE_PATH%"
    "%FNAME%"	"norm_10k"
    "%NAME%"    "Artificial dataset (normal distribution, ~10k nodes, mean=15, std_dev=5)"
    "%AUTHOR%"	"Benjamin E. Raabe"
    "%LICENSE%"	"Creative Commons 0 - Public Domain"

-execute "../scripts/scaling_test_template.s1"
    "%PATH%"  	"%BASE_PATH%"
    "%FNAME%"	"peaks_10k"
    "%NAME%"    "Artificial dataset (isolated peaks in distribution, ~10k nodes, degrees between 5 and 50, peaks every 5 datapoints)"
    "%AUTHOR%"	"Benjamin E. Raabe"
    "%LICENSE%"	"Creative Commons 0 - Public Domain"

-execute "../scripts/scaling_test_template.s1"
    "%PATH%"  	"%BASE_PATH%"
    "%FNAME%"	"uniform_10k"
    "%NAME%"    "Artificial dataset (uniform-distribution, ~10k nodes, degrees between 0 and 100)"
    "%AUTHOR%"	"Benjamin E. Raabe"
